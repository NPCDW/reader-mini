// 系统托盘：主窗口关掉以后程序还在这儿待着，靠托盘图标叫回来
export component TrayIcon inherits SystemTrayIcon {
    // 继承来的 icon / tooltip / title 不会自动生成 setter，
    // 这里再包一层自己的属性转出去，图标由 Rust 侧画好送进来
    in property <image> tray-icon;
    in property <string> tray-tooltip: "reader-mini";
    in property <string> tray-title: "reader-mini";

    icon: root.tray-icon;
    tooltip: root.tray-tooltip;
    title: root.tray-title;

    // 打开（或在打开状态下重新唤出）主窗口
    callback open-window();
    // 与全局快捷键同一个开关：开着就收起，关着就继续读
    callback toggle-reader();
    // 真正退出程序
    callback quit();

    // 左键直接点图标：等同“打开书架”（Windows / Linux 生效，macOS 有菜单时不触发）
    clicked => { root.open-window(); }

    Menu {
        MenuItem {
            title: "打开书架";
            activated => { root.open-window(); }
        }
        MenuItem {
            title: "继续阅读 / 收起";
            activated => { root.toggle-reader(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "退出";
            activated => { root.quit(); }
        }
    }
}
