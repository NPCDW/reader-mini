import { ReaderWindow } from "reader_win.slint";
import { VerticalBox, HorizontalBox, ScrollView, Button } from "std-widgets.slint";

export struct BookItem {
    name: string,
    author: string,
    intro: string,
    progress-text: string,
    latest: string,
}

export struct ChapterItem {
    title: string,
    index: int,
}

export component AppWindow inherits Window {
    title: "reader-mini";
    width: 1000px;
    height: 680px;
    background: #f5f5f7;

    in property <[BookItem]> books;
    in property <[ChapterItem]> chapters;
    in-out property <int> tab: 0;
    in-out property <int> page: 0;
    in-out property <int> current-book: -1;
    in-out property <string> base-url: "";
    in-out property <string> read-bg: "#f5f0e1";
    in-out property <string> read-fg: "#333333";
    in-out property <int> read-font-size: 20;
    in-out property <string> font-size-text: "20";
    in-out property <string> line-height-text: "1.5";
    in-out property <string> hotkey: "Ctrl+Alt+R";
    in-out property <string> hotkey-input: "Ctrl+Alt+R";
    in-out property <bool> capturing: false;

    // 一次按键事件 -> 配置串。修饰键单独按下不当输入，只在主键按下时才落地。
    public function hotkey-from-key(event: KeyEvent) {
        if (event.text == Key.Shift) { return; }
        if (event.text == Key.Control) { return; }
        if (event.text == Key.Alt) { return; }
        if (event.text == Key.Meta) { return; }

        root.hotkey-input = ""
            + root.hotkey-part(event.modifiers.control, "Ctrl")
            + root.hotkey-part(event.modifiers.alt, "Alt")
            + root.hotkey-part(event.modifiers.shift, "Shift")
            + root.hotkey-part(event.modifiers.meta, "Super")
            + root.hotkey-name(event);
        root.capturing = false;
    }

    public function hotkey-part(on: bool, name: string) -> string {
        return on ? (name + "+") : "";
    }

    public function hotkey-name(event: KeyEvent) -> string {
        if (event.text == Key.Space) { return "Space"; }
        if (event.text == Key.UpArrow) { return "Up"; }
        if (event.text == Key.DownArrow) { return "Down"; }
        if (event.text == Key.LeftArrow) { return "Left"; }
        if (event.text == Key.RightArrow) { return "Right"; }
        if (event.text == Key.PageUp) { return "PageUp"; }
        if (event.text == Key.PageDown) { return "PageDown"; }
        if (event.text == Key.Home) { return "Home"; }
        if (event.text == Key.End) { return "End"; }
        if (event.text == Key.Insert) { return "Insert"; }
        if (event.text == Key.Escape) { return "Esc"; }
        if (event.text == Key.Tab) { return "Tab"; }
        return event.text;
    }

   in-out property <string> status: "";
    in property <bool> loading: false;

    callback open-book(int);
    callback open-toc(int);
    // 目录页点击某个章节：从该章正文开头开始阅读
    callback open-chapter(int);
    callback save-settings(string, string, string, int, string, float);
    callback refresh();

    VerticalLayout {
        HorizontalLayout {
            height: 48px;
            padding: 6px;
            spacing: 6px;
            Rectangle {
                width: 88px;
                background: tab == 0 ? #4a6fa5 : #e3e6ea;
                border-radius: 6px;
                Text {
                    text: "书架";
                    color: tab == 0 ? white : #444;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea { clicked => { root.tab = 0; } }
            }
            Rectangle {
                width: 88px;
                background: tab == 1 ? #4a6fa5 : #e3e6ea;
                border-radius: 6px;
                Text {
                    text: "设置";
                    color: tab == 1 ? white : #444;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea { clicked => { root.tab = 1; } }
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 96px;
                background: #e3e6ea;
                border-radius: 6px;
                Text {
                    text: root.loading ? "加载中…" : "刷新";
                    color: #333;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea { clicked => { if (!root.loading) { root.refresh(); } } }
            }
        }

        if root.tab == 0 : VerticalLayout {
            if root.page == 0 : ScrollView {
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    for book[i] in root.books : Rectangle {
                        height: 100px;
                        background: white;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #e0e0e0;
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: start;
                                spacing: 2px;
                                Text { text: book.name; font-size: 18px; color: #222; }
                                Text { text: book.author + " · " + book.latest; font-size: 12px; color: #888; }
                                Text { text: book.progress-text; font-size: 12px; color: #4a6fa5; }
                                Text { text: book.intro; font-size: 12px; color: #666; wrap: word-wrap; vertical-stretch: 1; overflow: elide; }
                            }
                            VerticalLayout {
                                width: 130px;
                                spacing: 6px;
                                alignment: start;
                                Rectangle {
                                    height: 34px;
                                    background: #4a6fa5;
                                    border-radius: 6px;
                                    Text { text: "阅读"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.open-book(i); } }
                                }
                                Rectangle {
                                    height: 34px;
                                    background: #e3e6ea;
                                    border-radius: 6px;
                                    Text { text: "目录"; color: #333; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.page = 1; root.current-book = i; root.open-toc(i); } }
                                }
                            }
                        }
                    }
                    if root.books.length == 0 : Text {
                        text: root.loading ? "正在获取书架…" : "书架为空：请先在「设置」里填写 baseUrl，再点刷新";
                        color: #999;
                        horizontal-alignment: center;
                    }
                }
            }
            if root.page == 1 : VerticalLayout {
                padding: 10px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 88px;
                        height: 32px;
                        background: #e3e6ea;
                        border-radius: 6px;
                        Text { text: "← 返回"; color: #333; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.page = 0; } }
                    }
                    Text { text: "目录"; font-size: 16px; color: #222; vertical-alignment: center; }
                }
                ScrollView {
                    VerticalLayout {
                        spacing: 4px;
                        for ch[i] in root.chapters : Rectangle {
                            height: 36px;
                            background: touch.has-hover ? #eef2f8 : white;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 10px;
                                alignment: start;
                                Text { text: ch.title; color: #333; vertical-alignment: center; }
                            }
                            // 点章节 = 打开阅读窗口并跳到该章正文开头；停在目录页方便接着换章
                            touch := TouchArea { clicked => { root.open-chapter(ch.index); } }
                        }
                        if root.chapters.length == 0 : Text { text: "暂无目录"; color: #999; horizontal-alignment: center; }
                    }
                }
            }
        }

        if root.tab == 1 : ScrollView {
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: start;

                Text {
                    text: "服务地址 baseUrl";
                    font-size: 14px;
                    color: #333;
                    width: 100%;
                }
                Rectangle {
                    width: 100%;
                    height: 38px;
                    background: white;
                    border-width: 1px;
                    border-radius: 6px;
                    // 输入框始终有可见边框，聚焦时换个颜色提示
                    border-color: base-url.has-focus ? #4a6fa5 : #c8ced8;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        base-url := TextInput {
                            width: 100%;
                            height: 100%;
                            font-size: 14px;
                            vertical-alignment: center;
                            text <=> root.base-url;
                        }
                    }
                }

                Text {
                    text: "阅读窗口：背景色 / 字体色 / 字号";
                    font-size: 14px;
                    color: #333;
                    width: 100%;
                }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 38px;
                        background: white;
                        border-width: 1px;
                        border-radius: 6px;
                        border-color: read-bg.has-focus ? #4a6fa5 : #c8ced8;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            read-bg := TextInput {
                                width: 100%;
                                height: 100%;
                                font-size: 14px;
                                vertical-alignment: center;
                                text <=> root.read-bg;
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 38px;
                        background: white;
                        border-width: 1px;
                        border-radius: 6px;
                        border-color: read-fg.has-focus ? #4a6fa5 : #c8ced8;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            read-fg := TextInput {
                                width: 100%;
                                height: 100%;
                                font-size: 14px;
                                vertical-alignment: center;
                                text <=> root.read-fg;
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 38px;
                        background: white;
                        border-width: 1px;
                        border-radius: 6px;
                        border-color: font-size-input.has-focus ? #4a6fa5 : #c8ced8;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            font-size-input := TextInput {
                                width: 100%;
                                height: 100%;
                                font-size: 14px;
                                vertical-alignment: center;
                                input-type: number;
                                text: root.font-size-text;
                                edited => { root.read-font-size = self.text.to-float(); }
                            }
                        }
                    }
                }

                Text {
                    text: "行高倍数（相对字号，默认 1.5）";
                    font-size: 14px;
                    color: #333;
                    width: 100%;
                }
                Rectangle {
                    width: 100%;
                    height: 38px;
                    background: white;
                    border-width: 1px;
                    border-radius: 6px;
                    border-color: line-height-input.has-focus ? #4a6fa5 : #c8ced8;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        line-height-input := TextInput {
                            width: 100%;
                            height: 100%;
                            font-size: 14px;
                            vertical-alignment: center;
                            text <=> root.line-height-text;
                        }
                    }
                }

                Text {
                    text: "全局快捷键（呼出 / 关闭阅读窗口，保存后立即生效）";
                    font-size: 14px;
                    color: #333;
                    width: 100%;
                }
                HorizontalLayout {
                    spacing: 8px;
                    // 捕获框：不接收文本，直接听键盘按下，拼成 "Ctrl+Alt+R" 这种写法
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 38px;
                        background: white;
                        border-width: 1px;
                        border-radius: 6px;
                        border-color: root.capturing ? #4a6fa5 : #c8ced8;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: root.capturing
                                    ? (root.hotkey-input == "" ? "请按下组合键…" : root.hotkey-input)
                                    : (root.hotkey-input == "" ? "点击这里，再按下组合键" : root.hotkey-input);
                                color: root.capturing ? #4a6fa5 : #333;
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                        }
                        // 点一下开始录制，顺带把键盘焦点拿过来
                        capture-scope := FocusScope {
                            width: 100%;
                            height: 100%;
                            focus-on-click: true;
                            key-pressed(event) => {
                                root.hotkey-from-key(event);
                                accept
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.capturing = true;
                                root.hotkey-input = "";
                                capture-scope.focus();
                            }
                        }
                    }
                    Rectangle {
                        width: 96px;
                        height: 38px;
                        background: #e3e6ea;
                        border-radius: 6px;
                        Text {
                            text: "恢复默认";
                            color: #333;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.capturing = false;
                                root.hotkey-input = "Ctrl+Alt+R";
                            }
                        }
                    }
                }
                Text {
                    text: "当前生效：" + root.hotkey;
                    font-size: 12px;
                    color: #999;
                    width: 100%;
                }
                Button {
                    text: "保存设置";
                    width: 140px;
                    height: 38px;
                    clicked => {
                        root.capturing = false;
                        root.save-settings(
                            root.base-url,
                            root.read-bg,
                            root.read-fg,
                            root.read-font-size,
                            root.hotkey-input,
                            root.line-height-text.to-float(),
                        );
                    }
                }
                Text { text: root.status; color: #4a6fa5; font-size: 13px; width: 100%; }
            }
        }
    }
}
